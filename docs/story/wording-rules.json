  "conventions": {
    "grade": "fail = 회귀 실패. warn = 출력만 하고 통과. 출력에는 걸린 파일·키(또는 줄)·낱말·rule·note를 찍는다",
    "lang": "banned·restricted·name_shape·name_max_chars는 lang이 없으면 한국어 글(ko.po, 데이터 JSON, .gd 리터럴, 문서)에만 건다. en.po는 en_glossary와 lang이 'en'인 규칙만 본다",
    "keys": "판정은 '키'에 건다. ko.po·en.po는 msgid가 키다. 데이터 JSON은 key_map으로 키를 만든다(T3 2.2절 표). key_map에 없는 데이터 글은 'data:<파일 이름>:<JSON 경로>'를 키로 쓰고, applies_to가 없는 규칙만 건다",
    "key_map": {
      "chapter1/data/loot.json": {
        "bases[].name": "item.base.<id>.name",
        "affixes[].name": "item.affix.<id>.name",
        "legendaries[].name": "item.legendary.<id>.name",
        "legendaries[].description": "item.legendary.<id>.desc",
        "uniques[].name": "item.unique.<id>.name",
        "uniques[].description": "item.unique.<id>.desc",
        "rare_names.first[].name": "item.rare.first.<id>",
        "rare_names.second[].name": "item.rare.second.<id>",
        "slot_names.<slot>": "item.slot.<slot>"
      },
      "chapter1/data/skill_trees.json": {
        "trees[].tiers[].name": "tree.<tree_id>.tier.<level>.name",
        "trees[].branches[].name": "tree.<tree_id>.branch.<id>.name",
        "trees[].nodes[].name": "tree.<tree_id>.node.<id>.name",
        "trees[].nodes[].lore": "tree.<tree_id>.node.<id>.lore"
      },
      "chapter1/data/growth*.json": {
        "skills[].name": "skill.<id>.name",
        "skills[].evolved_name": "skill.<id>.evolved_name",
        "skills[].evolution_name": "skill.<id>.evolved_name",
        "passives[].name": "grace.passive.<id>.name"
      }
    },
    "code_literals": "scope.game_text의 .gd에서는 한글이 든 문자열 리터럴만 본다(주석 제외). 키가 없으므로 'code:<경로>'를 키로 쓰고, applies_to가 없는 banned·restricted 규칙만 건다. name_shape·name_max_chars·en_glossary는 걸지 않는다",
    "stems": "stems의 각 문자열이 글 안에 들어 있으면 걸린다(활용형을 줄기로 적었다). stems 대신 pattern(정규식, Python re)이 있으면 그것으로 찾는다",
    "exceptions": "걸린 자리를 덮는 exceptions 문자열이 같은 글 안에 있으면 그 자리는 통과한다(예: '기운 숄'의 '기운'). 걸린 낱말과 똑같은 한 낱말은 예외로 두지 않는다. 그런 것은 exception_keys(키 그대로)로 둔다",
    "applies_to": "키 패턴 목록(fnmatch). '@'로 시작하면 groups의 묶음이다. 없으면 scope.game_text 전체",
    "skip_docs": "true면 scope.docs에서는 보지 않는다(원문이 문서 쓰임을 허용한 낱말)",
    "status": "확정(기획자) / 채택(디렉터 안, 기획자 승인 또는 위임) / 잠정 / 미정. 항목에 status가 없으면 머리의 status를 따른다",
    "allow_pending": "file(glob)이 맞고, key_or_text가 키와 같거나 그 글 전체와 정확히 같으며(docs는 그 줄에 들어 있으면), word가 있으면 걸린 항목(banned·restricted의 word, name_shape의 id, en_glossary의 'ko=en')이 word와 같을 때만 통과한다. text가 있으면 지금 글이 text와 같을 때만 통과한다(글이 바뀌면 다시 걸린다). decision의 결정이 나서 글을 고치면 그 항목을 지운다",
    "not_machine_checked": [
      "WR 1.4 F3 뜻 없는 삼박자",
      "WR 1.2 #17 '결'의 추상 쓰임 가운데 아래 stems 밖의 것",
      "WR 1.3 (나)의 낱말이 정확한 뜻인지 비유인지(warn으로 내고 사람이 본다)",
      "WR 5절 3번 옮길 수 있는 말(말장난, 소리 겹침), 4번 한 화면에 한 말투",
      "IN 1.3 F 실·물레·가위를 묶어 쓰는 것, IN 1.3 E '결'(감정 용어)",
      "IN 1.5 전설 효과와 접사 이름의 같은 말(두 목록을 견주는 일)",
      "IN 1.6 다른 작품 이름과의 겹침(기억으로 판정한 목록만 아래에 있다)",
      "TP 7.2 '회랑의 서약을 완수했습니다'처럼 핵심어를 다른 뜻으로 쓴 것"
    ]
  },

  "groups": {
    "@names": ["*.name", "*.evolved_name", "item.rare.*", "item.affix.*", "item.slot.*", "item.set.*"],
    "@item_names": ["item.base.*.name", "item.affix.*", "item.legendary.*.name", "item.unique.*.name", "item.rare.*", "item.set.*"],
    "@items": ["item.*"],
    "@prose": ["*.lore", "*.desc", "story.*", "notify.*", "hud.notice.*", "result.*"],
    "@lore": ["*.lore"],
    "@stats": ["stat.*"]
  },

  "scope": {
    "game_text": {
      "include": ["chapter1/i18n/*.po", "chapter1/data/*.json", "chapter1/**/*.gd", "project.godot"],
      "exclude": ["chapter1/tests/**", "chapter1/core/chapter_items.gd", "chapter1/core/combat_run.gd", "chapter1/i18n/README.ko.md", "**/*.uid"],
      "json_fields": ["name", "evolved_name", "evolution_name", "title", "description", "lore", "slot_names"],
      "note": "loot.json rare_names의 legacy_names는 json_fields에 없어 검사하지 않는다: 화면에 나오지 않고 스키마 1~3 저장의 희귀 장비 이름을 새 첫말 id에 맞추는 데만 쓰는 옛 글이다(그래서 금지어가 들어 있어도 된다). 범위는 WR 3.1절과 같다. chapter_items.gd(장비 v1)는 옛 저장 검증용이라 바꾸지 않는다(IN 2.7, TP 7.3). combat_run.gd는 옛 실행 경로다(CLAUDE.md)"
    },
    "docs": {
      "grade": "warn",
      "include": ["docs/**/*.md", ".claude/agents/*.md", "AGENTS.md"],
      "exclude": [
        "docs/story/WORDING-RULES.ko.md",
        "docs/story/ITEM-NAMING.ko.md",
        "docs/SEASON1_WORLD_STORY_MASTER.md",
        "docs/roadmap-20261107/**",
        "docs/reviews/*-20??????*.md"
      ],
      "note": "WR 1.1: (가)는 문서 본문에도 건다. N48 권고: 기존 문서는 다음에 고칠 때 함께 고친다 — 그래서 문서는 모두 warn. 금지어 목록을 적은 두 문서, 기획자 원문(에이전트가 고치지 않는 파일), 날짜가 박힌 검수 기록(N57: 당시 기록)은 보지 않는다"
    }
  },

